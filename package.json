{
  "name": "vorp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "bun run voiceprint:assets && expo start --web",
    "export:web": "bun run voiceprint:assets && expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "token-server": "zig build --build-file server/build.zig run",
    "test:server": "cd server && zig build test",
    "e2e:live": "scripts/e2e/live.sh",
    "voiceprint:assets": "bun scripts/voiceprint/assets.ts",
    "smoke:voiceprint": "bun scripts/voiceprint/smoke.ts"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@google/genai": "^3.6.1",
    "@huggingface/transformers": "^4.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
