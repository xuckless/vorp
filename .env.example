# Copy to .env (git-ignored) and fill in. Never commit a real key.

# Token server (server/): the Gemini API key it trades for short-lived Live tokens.
# It never reaches the app bundle. `bun run token-server` reads this file in development.
GEMINI_API_KEY=
# Optional: PORT (8787), TOKEN_RATE_LIMIT (20 a minute per client), CORS_ORIGIN
# (http://localhost:8081 in development), WEB_DIR (serve the web export, e.g. dist).
# Behind a TLS proxy or load balancer, name it so the rate limit sees each client's address
# (X-Forwarded-For) instead of the proxy's: comma-separated addresses, CIDR ranges or
# loopback / private / link_local. Raise TOKEN_RATE_LIMIT when many visitors share one NAT.
# ANOLE_PROXY_TRUSTED=

# App (Expo inlines EXPO_PUBLIC_* into the client bundle, so only public values here).
# Where the app asks for a Live token. Defaults to /token on the same origin.
EXPO_PUBLIC_TOKEN_URL=http://localhost:8787/token
